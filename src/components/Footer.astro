---
const year = new Date().getFullYear();
---

<footer class="px-6 pb-10 pt-6 sm:px-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 border-t border-ink-faint/20 pt-8 text-sm text-ink-soft sm:flex-row sm:justify-between sm:gap-4"
  >
    <img
      class="h-10 w-10 rounded-lg object-contain"
      src={`${import.meta.env.BASE_URL}FotoempresaIcon.ico`}
      alt="Fotoempresa"
    />

    <!-- Enlaces legales (Privacy Policy / Terms of Service / LinkedIn) eliminados -->

    <span>© {year} Romanvisuals. All rights reserved.</span>
  </div>
</footer>
