---
/**
 * Sección de contacto.
 *
 * El formulario es el embed oficial de Youform, que se sirve en un iframe
 * desde app.youform.com. Al ser de otro dominio, sus campos NO se pueden
 * leer ni validar desde esta página: los campos requeridos y el formato del
 * email se configuran en el dashboard de Youform.
 *
 * Lo que sí se añade aquí son las guardas del embed que dependen de esta
 * página: estado de carga, aviso si el formulario no llega (timeout o sin
 * conexión) con reintento y enlace directo, y aviso de envío cuando
 * Youform redirige tras completar el formulario.
 *
 * El embed va dentro de una tarjeta sin fondo propio, con el borde y los
 * textos en la paleta de textos del sitio (tonos ink) y con data-autoresize,
 * para que el iframe mida lo que ocupa el formulario en lugar de reservar
 * una altura fija (data-height es solo la altura inicial hasta que Youform
 * reporta la real). El atributo data-transparency hace que el iframe no
 * pinte fondo propio, de modo que se vea el fondo de la página por detrás;
 * si el tema configurado en Youform es oscuro, basta con quitar
 * data-transparency para que el formulario traiga su fondo.
 *
 * El bloque aparece con un fade + subida la primera vez que entra en
 * pantalla (clases is-reveal / is-visible, que añade el script para que sin
 * JS no se oculte nada).
 */
const YOUFORM_FORM_ID = "addhdgkx";
const YOUFORM_BASE_URL = "https://app.youform.com";
const YOUFORM_FORM_URL = `${YOUFORM_BASE_URL}/forms/${YOUFORM_FORM_ID}`;
---

<section id="contact" class="px-6 py-28 sm:px-10 sm:py-36">
  <div
    class="relative mx-auto grid max-w-6xl gap-16 sm:grid-cols-2 sm:items-center sm:gap-24"
  >
    <div>
      <h2 data-fx-zoom class="font-display text-metal leading-[1.05] text-4xl font-semibold tracking-tight sm:text-5xl">
        LET'S WORK
        <span class="block">TOGETHER.</span>
      </h2>
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-soft">
        For inquiries, project proposals, or collaboration opportunities,
        please reach out via the form or email directly.
      </p>
    </div>

    <!-- Formulario (Youform) en tarjeta + estado de carga / error -->
    <div class="youform-guard" data-youform-guard>
      <div class="youform-panel">
        <div
          class="youform-frame"
          data-youform-embed
          data-form={YOUFORM_FORM_ID}
          data-base-url={YOUFORM_BASE_URL}
          data-width="100%"
          data-height="420"
          data-autoresize
          data-transparency="100"
        ></div>

        <div class="youform-state" data-youform-state aria-live="polite">
          <span class="youform-spinner" aria-hidden="true"></span>
          <p class="youform-state-msg" data-youform-state-msg>
            If the form doesn't load, open it in a new tab:
          </p>
          <button type="button" class="youform-retry" data-youform-retry hidden>
            TRY AGAIN
          </button>
          <a
            class="youform-fallback"
            data-youform-fallback
            href={YOUFORM_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the form in a new tab
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script oficial del embed: es externo, así que Astro no debe procesarlo -->
<script is:inline src="https://app.youform.com/embed.js"></script>

<script>
  type YouformState = "loading" | "ready" | "error" | "submitted";

  /** Mensajes que el embed de Youform envía por postMessage. */
  interface YouformMessage {
    name?: string;
    height?: number;
  }

  interface YouformHelper {
    init?: () => void;
  }

  const YOUFORM_SCRIPT_SRC = "https://app.youform.com/embed.js";
  /** Espera máxima desde que el formulario entra en pantalla. */
  const LOAD_TIMEOUT_MS = 15_000;
  /** Margen para que el formulario reporte su altura real (data-autoresize)
      antes de dar por hecho que ese aviso no va a llegar. */
  const HEIGHT_GRACE_MS = 6_000;
  /** El embed crea su iframe con loading="lazy": solo se descarga al
      acercarse a la ventana, así que el timeout no debe contar antes. */
  const WATCH_ROOT_MARGIN = "400px";

  const OFFLINE_MESSAGE =
    "You appear to be offline, so the form can't load. Reconnect or open it in a new tab.";
  const TIMEOUT_MESSAGE =
    "The form is taking too long to load. Check your connection or open it in a new tab.";
  const SUBMITTED_MESSAGE =
    "Thanks — your message is on its way. I'll reply within a day or two.";

  const guard = document.querySelector<HTMLElement>("[data-youform-guard]");
  const embedBox = guard?.querySelector<HTMLElement>("[data-youform-embed]") ?? null;
  const stateBox = guard?.querySelector<HTMLElement>("[data-youform-state]") ?? null;
  const stateMsg =
    guard?.querySelector<HTMLElement>("[data-youform-state-msg]") ?? null;
  const retryBtn =
    guard?.querySelector<HTMLButtonElement>("[data-youform-retry]") ?? null;

  if (guard && embedBox && stateBox && stateMsg) {
    const fallbackLink = guard.querySelector<HTMLAnchorElement>(
      "[data-youform-fallback]"
    );
    const youform = window as unknown as { YouformEmbed?: YouformHelper };

    let state: YouformState = "loading";
    let timer: number | undefined;
    /** ¿El formulario ya reportó su altura real? (ver data-autoresize) */
    let heightReported = false;
    let heightTimer: number | undefined;

    const currentFrame = (): HTMLIFrameElement | null =>
      embedBox.querySelector("iframe");

    const clearTimer = () => {
      if (timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
    };

    const clearHeightTimer = () => {
      if (heightTimer !== undefined) {
        window.clearTimeout(heightTimer);
        heightTimer = undefined;
      }
    };

    // Con data-autoresize el embed fija scrolling="no" en el iframe y espera
    // a que el formulario le reporte su altura. Si ese aviso no llegase, se
    // devuelve el scroll interno para no dejar contenido recortado.
    const armHeightFallback = () => {
      clearHeightTimer();
      heightTimer = window.setTimeout(() => {
        if (heightReported) return;
        const frame = currentFrame();
        if (!frame) return;
        frame.scrolling = "auto";
        frame.style.overflow = "auto";
      }, HEIGHT_GRACE_MS);
    };

    const setState = (next: YouformState, message?: string) => {
      state = next;
      guard.dataset.state = next;
      if (message !== undefined) stateMsg.textContent = message;
      stateBox.hidden = next === "ready";
      if (retryBtn) retryBtn.hidden = next !== "error";
      // El enlace directo solo hace falta si el embed no se ha podido cargar
      if (fallbackLink) fallbackLink.hidden = next !== "error";
    };

    const markReady = () => {
      if (state === "ready" || state === "submitted") return;
      clearTimer();
      setState("ready");
      armHeightFallback();
    };

    const markError = (message: string) => {
      if (state === "ready" || state === "submitted") return;
      clearTimer();
      setState("error", message);
    };

    const armTimeout = () => {
      clearTimer();
      timer = window.setTimeout(() => markError(TIMEOUT_MESSAGE), LOAD_TIMEOUT_MS);
    };

    // El embed avisa de que el formulario está listo con un postMessage
    // ("youformLoaded"); si ese mensaje no llegase, damos por cargado el
    // formulario cuando su iframe termina de cargar.
    const attachToFrame = () => {
      const frame = currentFrame();
      if (!frame || frame.dataset.guarded === "true") return;
      frame.dataset.guarded = "true";
      frame.addEventListener("load", markReady);
    };

    function retry() {
      clearTimer();
      clearHeightTimer();
      heightReported = false;
      setState("loading", "Loading the form…");

      const helper = youform.YouformEmbed;
      if (helper?.init) {
        // Vuelve a construir el iframe a partir de los data-* del div
        helper.init();
      } else {
        // El script del embed no llegó (bloqueado o sin red): se vuelve a
        // pedir; su IIFE ya llama a init() al ejecutarse.
        const script = document.createElement("script");
        script.src = YOUFORM_SCRIPT_SRC;
        script.addEventListener("load", () => youform.YouformEmbed?.init?.());
        document.head.append(script);
      }

      attachToFrame();
      armTimeout();
    }

    setState("loading", "Loading the form…");

    const observer = new MutationObserver(attachToFrame);
    observer.observe(embedBox, { childList: true, subtree: true });
    attachToFrame();

    window.addEventListener("message", (event) => {
      const frame = currentFrame();
      if (!frame || event.source !== frame.contentWindow) return;

      const data: unknown = event.data;
      if (data === "youformLoaded") {
        markReady();
        return;
      }
      if (typeof data !== "object" || data === null) return;

      // Altura real del formulario (data-autoresize): embed.js ya la aplica
      // al iframe; aquí solo se registra que llegó para no soltar el scroll.
      if ((data as YouformMessage).name === "youformResize") {
        heightReported = true;
        clearHeightTimer();
        return;
      }

      // Único aviso de envío que emite el embed: cuando el formulario está
      // configurado para redirigir al completarse (embed.js navega la página
      // a esa URL). Sin esa opción, la confirmación la muestra Youform dentro
      // de su propio iframe.
      if ((data as YouformMessage).name === "youformRedirect") {
        clearTimer();
        setState("submitted", SUBMITTED_MESSAGE);
      }
    });

    // Sin conexión el iframe no puede cargar: se avisa y se ofrece el enlace
    // directo; al recuperar la conexión se reintenta solo.
    window.addEventListener("offline", () => markError(OFFLINE_MESSAGE));
    window.addEventListener("online", () => {
      if (state === "error") retry();
    });

    retryBtn?.addEventListener("click", retry);

    const watchFromViewport = () => {
      if (state !== "loading") return;
      if (!navigator.onLine) markError(OFFLINE_MESSAGE);
      else armTimeout();
    };

    if (typeof IntersectionObserver === "function") {
      const watcher = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          watcher.disconnect();
          watchFromViewport();
        },
        { rootMargin: WATCH_ROOT_MARGIN }
      );
      watcher.observe(guard);
    } else {
      watchFromViewport();
    }
  }

  // ── Aparición del bloque al entrar en pantalla (una sola vez) ─────────
  const revealEl = document.querySelector<HTMLElement>("[data-youform-guard]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (revealEl && !reduceMotion && typeof IntersectionObserver === "function") {
    revealEl.classList.add("is-reveal");

    const onReveal = (
      entries: IntersectionObserverEntry[],
      observer: IntersectionObserver
    ) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        revealEl.classList.add("is-visible");
        observer.disconnect();
      }
    };

    const revealObserver = new IntersectionObserver(onReveal, {
      // threshold 0 + margen inferior: dispara igual con bloques cortos o
      // muy altos (un formulario largo nunca alcanzaría el 20% visible)
      threshold: 0,
      rootMargin: "0px 0px -12% 0px",
    });
    revealObserver.observe(revealEl);
  }
</script>

<style>
  .youform-guard {
    display: flex;
    flex-direction: column;
  }

  /* Aparición al entrar en pantalla: las clases las añade el script, así que
     sin JS el bloque se ve igual (nunca se queda oculto). */
  .youform-guard.is-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .youform-guard.is-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* Tarjeta del formulario: sin fondo (se ve el de la página) y con el
     borde en la misma paleta que los textos (ink-faint). */
  .youform-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 2rem;
    border: 1px solid rgba(167, 171, 163, 0.35);
    padding: 1.25rem;
  }

  @media (min-width: 640px) {
    .youform-panel {
      padding: 1.5rem;
    }
  }

  /* Hueco del iframe: se recorta al radio interior de la tarjeta */
  .youform-frame {
    border-radius: 1.25rem;
    overflow: hidden;
    transition: background-color 0.3s ease;
  }

  /* Mientras no ha cargado se reserva el espacio con un gris de la paleta de
     textos, para que el salto de layout al aparecer el formulario sea mínimo */
  .youform-guard:not([data-state="ready"]) .youform-frame {
    min-height: min(320px, 45svh);
    background: rgba(167, 171, 163, 0.14);
  }

  /* El iframe lo inyecta embed.js en tiempo de ejecución, así que no lleva
     el hash de scope del componente: la regla debe ir sin scope. */
  :global(.youform-frame iframe) {
    display: block;
    width: 100%;
    border: 0;
  }

  .youform-state {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }

  .youform-state[hidden] {
    display: none;
  }

  /* Carga: spinner + etiqueta centrados, con el tratamiento de eyebrow del
     sitio (mayúsculas, tracking amplio, ink-faint) */
  .youform-guard[data-state="loading"] .youform-state {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }

  .youform-guard[data-state="loading"] .youform-state-msg {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* Aviso (error o envío confirmado): panel sage, como el estado del
     calendario del sitio */
  .youform-guard[data-state="error"] .youform-state,
  .youform-guard[data-state="submitted"] .youform-state {
    align-items: center;
    gap: 0.875rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(167, 171, 163, 0.35);
    background: var(--color-sage);
    padding: 1.25rem 1.5rem;
    text-align: center;
  }

  .youform-guard[data-state="submitted"] .youform-state-msg {
    color: var(--color-forest);
    font-weight: 500;
  }

  .youform-spinner {
    flex: none;
    height: 0.875rem;
    width: 0.875rem;
    border-radius: 9999px;
    border: 2px solid rgba(167, 171, 163, 0.45);
    border-top-color: var(--color-forest);
    animation: youform-spin 0.8s linear infinite;
  }

  .youform-guard:not([data-state="loading"]) .youform-spinner {
    display: none;
  }

  @keyframes youform-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Botón "TRY AGAIN": mismo lenguaje que el botón del calendario */
  .youform-retry {
    cursor: pointer;
    border-radius: 9999px;
    border: 1px solid rgba(47, 91, 65, 0.35);
    padding: 0.45rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-forest);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .youform-retry:hover {
    background: var(--color-forest);
    color: var(--color-cream);
  }

  .youform-retry:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 2px;
  }

  .youform-retry[hidden] {
    display: none;
  }

  .youform-fallback {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .youform-fallback:hover {
    color: var(--color-forest-light);
  }

  .youform-fallback[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .youform-guard.is-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .youform-frame {
      transition: none;
    }
    .youform-spinner {
      animation: none;
    }
  }
</style>
