---
import "../styles/index.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Motion designer specializing in motion graphics for brands and AI platforms.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}FotoempresaIcon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="antialiased">
    <!-- Estela verde del cursor: por detrás del contenido, se mezcla solo con el fondo -->
    <div id="cursor-glow" aria-hidden="true"></div>
    <div id="cursor-glow-trail" aria-hidden="true"></div>
    <slot />

    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      /* ---- Efecto de scroll: zoom progresivo de titulares (p. ej.
             "MOTION DESIGNER FOR AI PLATAFORM") ---- */
      const zoomEls = Array.from(document.querySelectorAll("[data-fx-zoom]"));
      let zoomTick = false;

      const applyZoom = () => {
        zoomTick = false;
        const vh = window.innerHeight;
        for (const el of zoomEls) {
          const rect = el.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > vh) continue;
          // p: 0 cuando la sección entra por abajo → 1 cuando sale por arriba
          const p = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
          el.style.transform = `scale(${0.94 + 0.07 * p})`;
        }
      };

      if (zoomEls.length && !reduceMotion) {
        window.addEventListener(
          "scroll",
          () => {
            if (!zoomTick) {
              zoomTick = true;
              requestAnimationFrame(applyZoom);
            }
          },
          { passive: true },
        );
        window.addEventListener("resize", applyZoom);
        applyZoom();
      }

      /* ---- Estela verde que sigue al cursor (solo sobre el fondo) ---- */
      const glow = document.getElementById("cursor-glow");
      const trail = document.getElementById("cursor-glow-trail");
      const finePointer = window.matchMedia("(pointer: fine)").matches;

      if (glow && trail && finePointer && !reduceMotion) {
        let tx = window.innerWidth / 2;
        let ty = window.innerHeight / 3;
        let x = tx;
        let y = ty;
        let x2 = tx;
        let y2 = ty; // estela: sigue más lenta para crear el arrastre
        let raf = null;

        window.addEventListener(
          "pointermove",
          (event) => {
            tx = event.clientX;
            ty = event.clientY;
            if (!raf) raf = requestAnimationFrame(loop);
          },
          { passive: true },
        );

        function loop() {
          x += (tx - x) * 0.16;
          y += (ty - y) * 0.16;
          x2 += (tx - x2) * 0.07;
          y2 += (ty - y2) * 0.07;

          glow.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
          trail.style.transform = `translate3d(${x2}px, ${y2}px, 0) translate(-50%, -50%)`;
          raf = requestAnimationFrame(loop);
        }
      }
    </script>
  </body>
</html>
