# ─────────────────────────────────────────────────────────────────────────────
# Google Calendar — modo real (src/components/CalendarModal.astro)
#
# El componente se vincula a la API pública de Google Calendar v3 desde el
# navegador, por eso todas las variables llevan el prefijo PUBLIC_.
#
# Si estas dos variables NO están configuradas, el botón "OPEN CALENDAR" NO
# abre el modal del calendario: abre el link de PUBLIC_FIGMA_URL (diseño de
# referencia) en una pestaña nueva.
# ─────────────────────────────────────────────────────────────────────────────

# API key de Google Cloud con la "Google Calendar API" activada.
# Crear en: https://console.cloud.google.com/apis/credentials
# Recomendado: restringirla por "HTTP referrers (websites)" a tu dominio para
# que solo tu web pueda usarla.
PUBLIC_GOOGLE_CALENDAR_API_KEY=

# ID del calendario público que muestra la disponibilidad.
# En Google Calendar: Ajustes del calendario → "Integrar calendario" → ID.
# El calendario debe estar publicado ("Hacer disponible públicamente").
PUBLIC_GOOGLE_CALENDAR_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Link del calendario en Figma
# Lo abre el enlace "Calendar" de la cabecera en una pestaña nueva y, si no hay
# API de Google Calendar configurada, también es el respaldo del modal.
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_FIGMA_URL=https://www.figma.com/design/REEMPLAZA-CON-TU-LINK-DE-FIGMA

# ─────────────────────────────────────────────────────────────────────────────
# (Opcional) Días de descanso por título de evento
# Un evento cuyo título contenga una de estas palabras marca ese día como
# "Rest" aunque sea laborable (vacaciones, día libre…). Palabras por defecto
# si esta variable no se define: Rest,OFF,Descanso,Vacaciones,Vacation,Holiday
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_REST_KEYWORDS=Rest,OFF,Descanso,Vacaciones
